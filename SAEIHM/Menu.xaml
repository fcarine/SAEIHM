<Page x:Class="SAEIHM.Menu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SAEIHM"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Menu">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="40*"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="15*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="150*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="300*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="150*"/>
                <ColumnDefinition Width="30*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="Btnquitter" Grid.Column="1" 
             Background="Red" Foreground="White" 
            FontSize="20" FontWeight="Bold"
            Click="Btnquitter_Click">
                Quitter
            </Button>

            <Border Grid.Column="3" Background="#FF288AC7" >
                <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="White">
                MENU PRINCIPAL
                </TextBlock>
            </Border>


            <Button x:Name="Btnpara" Grid.Column="5" 
             Background="#FF288AC7" Foreground="White" 
            FontSize="18" FontWeight="Bold"
            Click="Btnpara_Click">
                Paramètre
            </Button>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="150*"/>
                <ColumnDefinition Width="40*"/>
                <ColumnDefinition Width="150*"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="Btnhisto" Grid.Column="1" 
                     Background="#FF288AC7" Foreground="White" 
                    FontSize="22" FontWeight="Bold"
                    Click="Btnhisto_Click">
                HISTORIQUE DU SCORE
            </Button>

            <Button x:Name="Btnaide" Grid.Column="3" 
                    Background="#FF288AC7" Foreground="White" 
                    FontSize="22" FontWeight="Bold"
                    Click="Btnaide_Click">
                REGLE ET AIDE
            </Button>
        </Grid>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="Btnjouer" Grid.Column="1" 
                    Background="#FF288AC7" Foreground="White" 
                    FontSize="26" FontWeight="Bold" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Click="Btnjouer_Click">
                JOUER
            </Button>
        </Grid>

    </Grid>
</Page>