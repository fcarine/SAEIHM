<Page x:Class="SAEIHM.Confpartie"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SAEIHM"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Puissance 4">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="96*"/>
            <RowDefinition Height="173*"/>
            <RowDefinition Height="181*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="15*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="15*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15*"/>
                <ColumnDefinition Width="80*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="280*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="80*"/>
                <ColumnDefinition Width="15*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="Btnretour" 
                    Background="#FF288AC7" Foreground="White" 
                    FontSize="24" FontWeight="Bold"
                    Click="Btnretour_Click" Grid.Row="1" Grid.Column="1">
                ⬅️
            </Button>

            <Border Grid.Column="3" Grid.RowSpan="3" Background="#FF288AC7">
                <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="White">
                    CONFIGURER PARTIE
                </TextBlock>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="200*"/>
                <ColumnDefinition Width="15*"/>
                <ColumnDefinition Width="90*"/>
                <ColumnDefinition Width="30*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" Text="Nombre de jetons à aligner" VerticalAlignment="Center" TextAlignment="Right"/>

            <Grid Grid.Column="3" VerticalAlignment="Center" Height="35">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="25*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Txtjeton" Grid.Column="0" Text="4" IsReadOnly="True" TextAlignment="Center" FontSize="18" FontWeight="Bold" VerticalContentAlignment="Center"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="▲" FontSize="8" Click="BtnAugmenter_Click"/>
                    <Button Grid.Row="1" Content="▼" FontSize="8" Click="BtnDiminuer_Click"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="200*"/>
                <ColumnDefinition Width="15*"/>
                <ColumnDefinition Width="90*"/>
                <ColumnDefinition Width="30*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" Text="Limite de temps par tours" VerticalAlignment="Center" TextAlignment="Right"/>

            <Grid Grid.Column="3" VerticalAlignment="Center" Height="35">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="25*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Txttemps" Grid.Column="0" Text="30" IsReadOnly="True" TextAlignment="Center" FontSize="18" FontWeight="Bold" VerticalContentAlignment="Center"/>
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="▲" FontSize="8" Click="BtnAugmenter1_Click"/>
                    <Button Grid.Row="1" Content="▼" FontSize="8" Click="BtnDiminuer1_Click"/>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="46,0,354,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="33*"/>
                <ColumnDefinition Width="137*"/>
                <ColumnDefinition Width="98*"/>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="125*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1" Text="Taille de la grille" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right" Height="23"/>
            <ComboBox x:Name="grille" Grid.Column="2" VerticalContentAlignment="Center"
                      ItemsSource="{Binding Collection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      SelectedItem="{Binding GridVM.SelectedGrid}" DisplayMemberPath="Label" Margin="26,74,0,75"/>
        </Grid>

        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="41*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40*"/>
                <ColumnDefinition Width="250*"/>
                <ColumnDefinition Width="40*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="1" Grid.Column="1" FontSize="18" FontWeight="Bold" Background="#FF288AC7" Foreground="White"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="Button_Click">
                Réinitialise par défaut
            </Button>

            <Button x:Name="Btnvalide" Grid.Row="3" Grid.Column="1" Background="#FF288AC7" Foreground="White"
                    FontSize="18" FontWeight="Bold" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="Btnvalide_Click">
                Valider
            </Button>
        </Grid>

    </Grid>
</Page>