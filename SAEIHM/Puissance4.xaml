<Page x:Class="SAEIHM.Puissance4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SAEIHM"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Puissance4">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Grille centrée -->
            <RowDefinition Height="Auto"/>
            <!-- Footer VALIDER -->
        </Grid.RowDefinitions>

        <!-- ═══ HEADER : nom joueur + bouton pause ═══ -->
        <Grid Grid.Row="0" Margin="20,18,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Bandeau nom joueur (centré visuellement sur toute la largeur) -->
            <Border Grid.Column="0" Background="#4AADEA" CornerRadius="30"
                Margin="0,0,12,0" Padding="0,12">
                <TextBlock x:Name="TbNomCourant"
                       FontSize="26" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center"/>
            </Border>

            
        </Grid>

        <!-- ═══ GRILLE centrée ═══ -->
        <Border Grid.Row="1"
            Background="#E8E8E8" CornerRadius="10"
            Margin="80,20,80,0"
            Padding="12">
            <UniformGrid x:Name="GrilleUI" Rows="6" Columns="7"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Border>

    </Grid>
</Page>
