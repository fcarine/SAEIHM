<Page x:Class="SAEIHM.Puissance4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SAEIHM"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Puissance4">

    <Grid Background="white">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER : fond bleu, affiche le tour -->
        <Border Grid.Row="0" Background="#FF288AC7" CornerRadius="8" Margin="10,10,10,5" Padding="8">
            <TextBlock x:Name="TbJoueur" FontSize="22" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
        </Border>

        <!-- GRILLE -->
        <Border Grid.Row="1" Background="#FF288AC7" CornerRadius="8" Margin="10" Padding="6">
            <ItemsControl x:Name="GrilleUI" Grid.Row="1"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Margin="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid x:Name="UG"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="52" Height="52" Margin="3"
                            Tag="{Binding X}" Click="Cellule_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse Fill="White" Stroke="Gray" StrokeThickness="1.5"/>
                                        <Ellipse x:Name="Pion" Margin="4" Fill="{Binding Couleur}" Visibility="Collapsed"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Etat}" Value="1">
                                            <Setter TargetName="Pion" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Etat}" Value="2">
                                            <Setter TargetName="Pion" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- FOOTER -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="BtnValider" Content="Rejouer" Width="90" Height="32" Margin="5" Click="BtnValider_Click" Background="#FF288AC7" FontSize="18" FontWeight="Bold" Foreground="White"/>
            <Button x:Name="BtnPause" Content="Pause" Width="90" Height="32" Margin="5" Click="BtnPause_Click" Background="#FF288AC7" FontSize="18" FontWeight="Bold" Foreground="White"/>
            <Button x:Name="BtnMenu" IsEnabled="False" Content="Menu" Width="100" Height="32" Margin="5" Click="BtnMenu_Click" Background="#FF288AC7" FontSize="18" FontWeight="Bold" Foreground="White"/>
        </StackPanel>
    </Grid>
</Page>
