<Page x:Class="SAEIHM.PageChoisirMode"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SAEIHM"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageChoisirMode">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="11*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock FontSize="30"  FontWeight="Bold" Background="#FF288AC7" Foreground="White" Grid.ColumnSpan="3" Margin="200,10,200,20" TextAlignment="Center" VerticalAlignment="Center" Height="67" Padding="0,10,0,0">JOUER</TextBlock>
        <Button x:Name="btnretour" Margin="33,19,150,36" FontSize="24" Background="#FF288AC7" Foreground="White" Click="btnretour_Click">⬅️</Button>
        <Button Margin="68,22,68,303" Grid.Row="1" FontWeight="Bold" Background="#FF288AC7" Foreground="White" FontSize="18">LOCAL</Button>
        <Button Margin="68,22,68,303" Grid.Row="1" Grid.Column="1" FontWeight="Bold" Background="#FF288AC7" Foreground="White" FontSize="18">CONTRE IA</Button>
        <Button Margin="68,22,68,303" Grid.Row="1" Grid.Column="2" FontWeight="Bold" Background="#FF288AC7" Foreground="White" FontSize="18">EN LIGNE</Button>


    </Grid>
</Page>
