<Page x:Class="SAEIHM.PageChoisirMode"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SAEIHM"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageChoisirMode">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="190*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="80*"/>
            <RowDefinition Height="15*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="15*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="15*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15*"/>
                <ColumnDefinition Width="80*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="280*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="80*"/>
                <ColumnDefinition Width="15*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="Btnretour" 
                    Background="#FF288AC7" Foreground="White" 
                    FontSize="24" FontWeight="Bold"
                    Click="Btnretour_Click" Grid.Row="1" Grid.Column="1">
                ⬅️
            </Button>

            <Border Grid.Column="3" Grid.RowSpan="3" Background="#FF288AC7">
                <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="White">
                    JOUER
                </TextBlock>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="230*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="230*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="230*"/>
                <ColumnDefinition Width="30*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40*"/>
                    <RowDefinition Height="150*"/>
                </Grid.RowDefinitions>

                <RadioButton x:Name="Btnlocal" Grid.Row="0" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="RadioButton_Checked">LOCAL</RadioButton>

                <Grid x:Name="local" Grid.Row="1" IsEnabled="False" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold" Text="Saisir nom 1 :" />
                    <TextBox x:Name="n1" Grid.Row="1" TextChanged="VerifEtat" Text="{Binding Nom1, UpdateSourceTrigger=PropertyChanged}" FontSize="14" VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Row="3" FontSize="18" FontWeight="Bold" Text="Saisir nom 2 :" />
                    <TextBox x:Name="n2" Grid.Row="4" TextChanged="VerifEtat" Text="{Binding Nom2, UpdateSourceTrigger=PropertyChanged}" FontSize="14" VerticalContentAlignment="Center"/>
                </Grid>
            </Grid>

            <Rectangle Grid.Column="2" Fill="#FF288AC7" Width="2" VerticalAlignment="Stretch" />

            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40*"/>
                    <RowDefinition Height="150*"/>
                </Grid.RowDefinitions>

                <RadioButton x:Name="BtnIA" Grid.Row="0" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="RadioButton_Checked">CONTRE IA</RadioButton>

                <Grid x:Name="IA" Grid.Row="1" IsEnabled="False" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35*"/>
                        <RowDefinition Height="35*"/>
                        <RowDefinition Height="35*"/>
                    </Grid.RowDefinitions>
                    <RadioButton x:Name="facile" Grid.Row="0" Unchecked="VerifEtat" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">Facile</RadioButton>
                    <RadioButton x:Name="moyen" Grid.Row="1" Unchecked="VerifEtat" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">Moyen</RadioButton>
                    <RadioButton x:Name="difficile" Grid.Row="2" Unchecked="VerifEtat" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center">Difficile</RadioButton>
                </Grid>
            </Grid>

            <Rectangle Grid.Column="4" Fill="#FF288AC7" Width="2" VerticalAlignment="Stretch" Margin="0,10"/>

            <Grid Grid.Column="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40*"/>
                    <RowDefinition Height="150*"/>
                </Grid.RowDefinitions>

                <RadioButton x:Name="Btnligne" Grid.Row="0" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="RadioButton_Checked">EN LIGNE</RadioButton>

                <Grid x:Name="ligne" Grid.Row="1" IsEnabled="False" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="45"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*"/>
                        <ColumnDefinition Width="150*"/>
                        <ColumnDefinition Width="20*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="Btnconnecter" Grid.Row="0" Grid.Column="1" Background="#FF288AC7" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="Btnconnecter_Click">Se connecter</Button>
                    <Button x:Name="Btninscrit" Grid.Row="2" Grid.Column="1" Background="#FF288AC7" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="Btninscrit_Click">S'inscrire</Button>
                </Grid>
            </Grid>
        </Grid>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="Btnvalide" Grid.Column="1" IsEnabled="False" 
                    Background="#FF288AC7" Foreground="White" 
                    FontSize="26" FontWeight="Bold" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Click="Btnvalide_Click">
                Valider
            </Button>
        </Grid>

    </Grid>
</Page>