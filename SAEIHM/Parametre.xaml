<Page x:Class="SAEIHM.Parametre"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SAEIHM"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Puissance 4">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="11*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>



        <TextBlock FontSize="30"  FontWeight="Bold" Background="#FF288AC7" Foreground="White" Grid.ColumnSpan="2" Margin="200,10,200,20" TextAlignment="Center" VerticalAlignment="Center" Height="67" Padding="0,10,0,0">PARAMETRE GENERAUX</TextBlock>
        <Button x:Name="Btnretour" Margin="33,19,300,36" FontSize="24" Background="#FF288AC7" Foreground="White" Click="Btnretour_Click">⬅️</Button>

        <StackPanel Margin="10,34,10,70" Grid.Row="1">
            <TextBlock FontSize="22" FontWeight="Bold" Margin="40,0,0,30">Modifie la taille de la police:</TextBlock>
            <TextBlock FontSize="22" FontWeight="Bold" Margin="40,0,0,30">Activation du son:</TextBlock>
            <TextBlock FontSize="22" FontWeight="Bold" Margin="40,0,0,30">Activation de la musique du jeu:</TextBlock>
            <TextBlock FontSize="22" FontWeight="Bold" Margin="40,0,0,0">Choisir la langue:</TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10,34,10,70" Grid.Row="1">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TxtFontSize" Width="60" Text="18" IsReadOnly="True" TextAlignment="Center" FontSize="18" FontWeight="Bold"/>
                <StackPanel>
                    <Button Content="▲" Width="25" Height="20" Click="BtnAugmenter_Click"/>
                    <Button Content="▼" Width="25" Height="20" Click="BtnDiminuer_Click"/>
                </StackPanel>
            </StackPanel>

            <ToggleButton Width="60" Height="30" Margin="-300,20,0,0">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border x:Name="SwitchBorder" CornerRadius="15" Background="red"/>
                                        <Ellipse x:Name="SwitchKnob" Width="26" Height="26" Fill="White" HorizontalAlignment="Left" Margin="2"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="SwitchBorder" Property="Background" Value="LimeGreen"/>
                                            <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <ToggleButton Width="60" Height="30" Margin="-300,30,0,0">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border x:Name="SwitchBorder" CornerRadius="15" Background="Red"/>
                                        <Ellipse x:Name="SwitchKnob" Width="26" Height="26" Fill="White" HorizontalAlignment="Left" Margin="2"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="SwitchBorder" Property="Background" Value="LimeGreen"/>
                                            <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <ComboBox x:Name="nationalite"  ItemsSource="{Binding NationaliteVM.Collection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Pays" Width="150" Margin="-200,40,0,0"/>
        </StackPanel>

        <Button x:Name="Btnvalide" Background="#FF288AC7" FontSize="18" FontWeight="Bold" Grid.Column="1" Margin="241,27,36,36" RenderTransformOrigin="0.49,0.017" Foreground="White" Click="Btnvalide_Click">Valider</Button>

    </Grid>
</Page>
