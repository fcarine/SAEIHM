<Page x:Class="SAEIHM.Conftouche"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SAEIHM"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Puissance 4">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="100*"/>
            <RowDefinition Height="30*"/>
            <RowDefinition Height="70*"/>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="205*"/>
            <RowDefinition Height="15*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="15*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="15*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15*"/>
                <ColumnDefinition Width="80*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="280*"/>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="80*"/>
                <ColumnDefinition Width="15*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="Btnretour" 
                    Background="#FF288AC7" Foreground="White" 
                    FontSize="24" FontWeight="Bold"
                    Click="Btnretour_Click" Grid.Row="1" Grid.Column="1">
                ⬅️
            </Button>

            <Border Grid.Column="3" Grid.RowSpan="3" Background="#FF288AC7">
                <TextBlock TextAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="White">
                    CONFIGURER TOUCHES
                </TextBlock>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="150*"/>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="150*"/>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="150*"/>
                <ColumnDefinition Width="100*"/>
            </Grid.ColumnDefinitions>

            <RadioButton x:Name="souris" Grid.Column="1" Unchecked="VerifEtat" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">SOURIS</RadioButton>
            <RadioButton x:Name="clavier" Grid.Column="3" Unchecked="VerifEtat" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Checked="clavier_Checked">CLAVIER</RadioButton>
            <RadioButton x:Name="tactile" Grid.Column="5" Unchecked="VerifEtat" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center">TACTILE</RadioButton>
        </Grid>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="450*"/>
                <ColumnDefinition Width="50*"/>
                <ColumnDefinition Width="200*"/>
                <ColumnDefinition Width="50*"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="clavierlabel" Grid.Column="1" IsEnabled="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <TextBlock FontSize="18" FontWeight="Bold" Text="Touche pour sélectionner la case :" VerticalAlignment="Center" Height="24"/>
                <Grid Grid.Row="1" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="1" FontSize="18" FontWeight="Bold">Entrée</RadioButton>
                    <RadioButton Grid.Column="3" FontSize="18" FontWeight="Bold">Espace</RadioButton>
                </Grid>

                <TextBlock Grid.Row="3" FontSize="18" FontWeight="Bold" Text="Touche pour naviguer sur la grille :" VerticalAlignment="Center" Height="23"/>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="1" FontSize="18" FontWeight="Bold">← →</RadioButton>
                    <RadioButton Grid.Column="3" FontSize="18" FontWeight="Bold">A D</RadioButton>
                    <RadioButton Grid.Column="5" FontSize="18" FontWeight="Bold">Q D</RadioButton>
                </Grid>
            </Grid>

            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Button x:Name="Btnvalide" Grid.Row="1" IsEnabled="False" 
                        Background="#FF288AC7" Foreground="White" 
                        FontSize="18" FontWeight="Bold" 
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Click="Btnvalide_Click">
                    Valider
                </Button>
            </Grid>
        </Grid>

    </Grid>
</Page>